<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting in Night Mode -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">#111726</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!-- Theme applied to the Android Window once Flutter initializes in Night Mode -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">#111726</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
